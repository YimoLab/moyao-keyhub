{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨钥 KeyHub",
  "version": "0.1.0",
  "identifier": "cn.casuainess.keyhub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "墨钥 KeyHub",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "copyright": "KeyHub",
    "category": "DeveloperTool",
    "shortDescription": "多平台 SSH 密钥管理桌面程序",
    "longDescription": "墨钥 KeyHub —— 可视化、零命令行、安全可控的桌面端 SSH 密钥全生命周期管理工具。全部数据仅存于本机 ~/.ssh 目录，程序默认不发起任何网络请求。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "openssh-client"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YimoLab/moyao-keyhub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMkMwOTEwQjM5MThDNjUKUldSbGpKR3pFQWtzNHJPeGVVaDBUM0VXNm0vYnVPV3JHWjdMeFNFVm9nNlVLdXlvaUhXelBRK0gK"
    }
  }
}
