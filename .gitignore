# ══════════════════════════════════════════════════════════════
# 墨钥 KeyHub · Git 忽略规则
# 原则：依赖、构建产物、本机环境、密钥材料、临时调试文件一律不进仓库。
# ══════════════════════════════════════════════════════════════

# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 构建产物 ──────────────────────────────────────────
dist/
src-tauri/target/

# build.rs 归集的 WebView2Loader.dll。
# 需要入库：CI 的干净检出（MSVC）找不到 webview2-com-sys 的 DLL 输出，
# 而 tauri.conf 的 bundle.resources 又要求该路径存在。
src-tauri/binaries/*
!src-tauri/binaries/WebView2Loader.dll

# Tauri 自动生成的权限 schema（tauri dev / build 会重建）
src-tauri/gen/schemas/

# ── 密钥与敏感数据（防误提交）─────────────────────────
# 本项目的密钥永远在用户 ~/.ssh 下，仓库里不应出现任何密钥材料
.env
.env.*
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
*.khbak

# ── 本机工具与工作记录 ────────────────────────────────
# 开发记忆 / 工具缓存中包含本机路径与用户名，不随仓库分发
.workbuddy/
.ccgui/
.impeccable/
.playwright-mcp/

# 高保真设计稿：本地保留，不随开源仓库分发（仅根目录）
/ui/

# 产品需求与开发记录：本地保留，不随仓库分发
docs/

# CDP 无头浏览器调试残留（用户数据目录，单个可达 17 MB）
.chrome-cdp*/
.chrome-profile/

# ── 临时文件 ──────────────────────────────────────────
*.log
*.tmp
*.bak
*.local

# Cloudflare Wrangler 本地状态
.wrangler/

# 调试时的临时输出（曾在本项目根目录与 src-tauri/ 下堆积 100+ 个）
.*.txt
.preview.err
.preview.log

# scripts/ 下的临时调试脚本；正式脚本不带下划线前缀
scripts/_*.mjs

# 图标生成器的输出目录（打包实际使用的是 src-tauri/icons/）
scripts/icons/

# 设计稿渲染工具的元数据（不是设计稿本身）
*.artifact.json

# ── 编辑器 / 系统 ─────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
desktop.ini
Thumbs.db
